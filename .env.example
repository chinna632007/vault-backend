# Backend service settings (local MongoDB example)
PORT=3000
MONGO_URI=mongodb://localhost:27017/docuvault
JWT_SECRET=replace-with-a-long-random-secret

# SMTP credentials for sending password reset links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=DocuVault <your-app-email@gmail.com>

# Public URL where the DocuVault frontend is hosted (local Vite uses port 3030)
FRONTEND_URL=http://localhost:3030
