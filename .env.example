# DocuVault backend environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env or real credentials to version control (.env is gitignored).

PORT=3000
MONGO_URI=mongodb://localhost:27017/docuvault
JWT_SECRET=replace-with-a-long-random-secret

# Gmail API OAuth settings — used ONLY by the backend to send password-reset emails.
# These credentials are read server-side only. Never expose them to the frontend.
# Create OAuth 2.0 Web application credentials at: Google Cloud Console -> APIs & Services -> Credentials
# Enable the Gmail API for your project.
# Generate a refresh token (offline access) for the sender Gmail account.
GMAIL_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth2-client-secret
GMAIL_REFRESH_TOKEN=your-oauth2-refresh-token
GMAIL_SENDER=DocuVault <docuvault.sender@gmail.com>

# Frontend origin — used to build the password-reset link sent by email
FRONTEND_URL=https://my-docuvault-site.example
# Local development example: FRONTEND_URL=http://localhost:3030

# Server public URL — used for API base URL and deployment flexibility
# Change this to your server IP/host when deploying (e.g., http://your-server-ip:3000 or https://domain.com)
SERVER_URL=http://localhost:3000

# Backend public URL — used for password-reset email links
# Set this to your Render backend URL when deployed (e.g., https://docuvault-backend.onrender.com)
BACKEND_PUBLIC_URL=http://localhost:3000

# Deployment note for Render:
# Gmail API uses HTTPS (port 443), which is not blocked by Render Free plan.
# Make sure the Gmail API is enabled in your Google Cloud project.
# The OAuth client must be a Web application type (not Desktop or Android).
# The refresh token grants offline access to send emails as GMAIL_SENDER.
