# DocuVault backend environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env or real credentials to version control (.env is gitignored).

PORT=3000
MONGO_URI=mongodb://localhost:27017/docuvault
JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings — used ONLY by the backend to send password-reset emails.
# SMTP_USER = your sending Gmail account
# SMTP_PASS = that account's Google App Password (16 chars, NOT your Gmail login password)
# Generate an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=docuvault.sender@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM=DocuVault <docuvault.sender@gmail.com>

# SMTP connection timeouts (prevents hanging on platforms like Render that block SMTP)
# Values in milliseconds
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=5000

# Frontend origin — used to build the password-reset link sent by email
FRONTEND_URL=https://my-docuvault-site.example
# Local development example: FRONTEND_URL=http://localhost:3030

# Deployment note for Render:
# Render may block outbound SMTP port 587 on free/paid tiers. If email sending
# times out with ETIMEDOUT, consider:
# 1. Using a different SMTP provider (SendGrid, Mailgun, etc.)
# 2. Using an email API service instead of SMTP
# 3. Contacting Render support to unblock SMTP outbound
