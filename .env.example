# SMTP credentials for sending password reset links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=DocuVault <your-app-email@gmail.com>

# Public URL where the DocuVault frontend is hosted
FRONTEND_URL=http://localhost:5173
